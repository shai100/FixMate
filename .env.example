DATABASE_URL=postgresql+asyncpg://fixmate:fixmate@localhost:5432/fixmate
DATABASE_APP_URL=postgresql+asyncpg://fixmate_app:fixmate_app@localhost:5432/fixmate  # app role, RLS enforced
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fixmate
S3_SECRET_KEY=fixmate123
S3_BUCKET=fixmate
LLM_PROVIDER=ollama                # ollama | anthropic  (spec §8.3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.2:3b   # non-reasoning instruct model; fits 4 GB GPU at Q4 (~40-80 t/s)
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBED_ON_CPU=true              # pin bge-m3 to CPU so generation keeps the GPU to itself
ANTHROPIC_API_KEY=                 # only when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-4-8
DEV_AUTH=true                      # Phase 6 header auth; must be false outside local
DEV_AUTO_LOGIN=true               # local only: web auto-signs-in as demo-tenant admin via /dev/auto-login
DEV_DEMO_ORG=FixMate Demo          # org name /dev/auto-login resolves (matches scripts/seed_demo.py)
ENV=local                          # local | staging | production (DEV_AUTH must be false unless local)
KEYCLOAK_BASE_URL=http://localhost:8080   # Phase 9 OIDC issuer base (used when DEV_AUTH=false)
KEYCLOAK_REALM=fixmate
OIDC_CLIENT_ID=fixmate-api
OIDC_VERIFY_AUDIENCE=false          # Keycloak access tokens default aud=account
